#!/usr/bin/env bash
# Managed by Ansible. Obtain/renew the wildcard cert and publish for services.
# lego v5 unified run+renew into a single `lego run` (obtains if missing,
# renews when due) and moved the former global flags to command-level
# (they go AFTER `run`). Self-contained: sources the Cloudflare token from
# the env file if it is not already in the environment (so it works both
# under systemd and when run directly by Ansible).
set -euo pipefail

LEGO=/usr/local/bin/lego
DATA=/var/lib/lego
PUB="{{ cert_publish_dir }}"

if [ -z "${CLOUDFLARE_DNS_API_TOKEN:-}" ] && [ -f /etc/lego/cloudflare.env ]; then
  set -a; . /etc/lego/cloudflare.env; set +a
fi

ARGS=(run --accept-tos --path "$DATA" --email "{{ acme_email }}" --dns cloudflare)
{% for d in cert_domains %}
ARGS+=(--domains "{{ d }}")
{% endfor %}

"$LEGO" "${ARGS[@]}"

# Locate the leaf cert + key wherever lego placed them (layout-agnostic)
CRT="$(find "$DATA" -type f -name '*.crt' ! -name '*.issuer.crt' 2>/dev/null | head -1)"
KEY="${CRT%.crt}.key"

if [ -z "$CRT" ] || [ ! -f "$CRT" ] || [ ! -f "$KEY" ]; then
  echo "ERROR: certificate or key not found under $DATA" >&2
  exit 1
fi

install -m 0640 -g {{ cert_sync_user }} "$CRT" "$PUB/fullchain.pem"
install -m 0640 -g {{ cert_sync_user }} "$KEY" "$PUB/privkey.pem"
