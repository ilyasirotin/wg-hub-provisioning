#!/usr/bin/env bash
# Managed by Ansible. Mirrors the BGP-elected exit default into the kernel
# and WireGuard. bgpd elects the best 0.0.0.0/0 from exit-capable sites
# (route-map OVERLAY-IN), but zebra never installs it (route-map
# BGP-TO-KERNEL denies it — `set table` silently fails to load on FRR 10).
# This daemon polls the election result and programs both halves of the
# data path:
#   - the default route in PBR table {{ wg_pbr_table }} (proto static,
#     metric 20 — shadows the unreachable floor from wg0-routes.sh),
#   - the 0.0.0.0/0 AllowedIPs of the elected peer (cryptokey routing).
# No BGP default -> remove both (fail closed via the floor).
#
# Deliberately no `set -e`: the reconcile loop must survive transient errors.
set -u

IFACE="{{ wg_interface }}"
TABLE="{{ wg_pbr_table }}"
MAP=/etc/wireguard/exit-peers.map
INTERVAL=5   # poll period, seconds; failover latency = BGP detection + this

desired_gw() { # nexthop of bgpd's current best valid 0.0.0.0/0, if any
  vtysh -c 'show bgp ipv4 unicast 0.0.0.0/0 json' 2>/dev/null | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except ValueError:
    sys.exit(0)
for p in d.get("paths", []):
    if p.get("bestpath", {}).get("overall") and p.get("valid"):
        nh = (p.get("nexthops") or [{}])[0].get("ip")
        if nh:
            print(nh)
        break
'
}
current_gw() { # nexthop of the daemon-installed default in $TABLE, if any
  ip -4 route show table "$TABLE" \
    | awk '$1 == "default" && / proto static / { for (i=1;i<NF;i++) if ($i=="via") { print $(i+1); exit } }'
}
current_owner() { # pubkey currently holding 0.0.0.0/0, if any
  wg show "$IFACE" allowed-ips \
    | awk '{ for (i=2;i<=NF;i++) if ($i == "0.0.0.0/0") { print $1; exit } }'
}
map_by_gw()    { awk -v k="$1" '$1 == k { print $2, $3; exit }' "$MAP"; }
base_for_pub() { awk -v k="$1" '$2 == k { print $3; exit }' "$MAP"; }

reconcile() {
  local gw cur have pub base
  gw=$(desired_gw); cur=$(current_owner); have=$(current_gw)
  if [ -z "$gw" ]; then
    # Fail closed: no exit site announces a default.
    if [ -n "$have" ]; then
      echo "no BGP default: removing default via $have from table $TABLE"
      ip route del default proto static table "$TABLE" 2>/dev/null || true
    fi
    if [ -n "$cur" ]; then
      base=$(base_for_pub "$cur")
      if [ -n "$base" ]; then
        echo "no BGP default: stripping 0.0.0.0/0 from $cur"
        wg set "$IFACE" peer "$cur" allowed-ips "$base"
      else
        echo "WARNING: 0.0.0.0/0 owned by unmapped peer $cur; leaving as-is"
      fi
    fi
    return 0
  fi
  read -r pub base <<<"$(map_by_gw "$gw")"
  if [ -z "${pub:-}" ]; then
    echo "WARNING: BGP default via $gw has no entry in $MAP; ignoring"
    return 0
  fi
  if [ "$have" != "$gw" ]; then
    echo "table $TABLE: default -> via $gw"
    ip route replace default via "$gw" dev "$IFACE" table "$TABLE" metric 20 proto static
  fi
  if [ "$cur" != "$pub" ]; then
    echo "exit flip: ${cur:-<none>} -> $pub (via $gw)"
    # AllowedIPs form one trie per interface: this atomically steals
    # 0.0.0.0/0 from the previous owner. Single call, no cleanup needed.
    wg set "$IFACE" peer "$pub" allowed-ips "$base,0.0.0.0/0"
  fi
}

# Also covers `wg syncconf` stripping 0/0 (the Ansible handler restarts us
# for the fast path; the poll is the safety net).
reconcile
while sleep "$INTERVAL"; do
  reconcile
done
