#!/usr/bin/env bash
# Managed by Ansible. Overlay/site routes and home-profile PBR.
# Kept out of PostUp so that peer changes apply via `wg syncconf`
# without restarting the interface.
set -eu

IFACE="{{ wg_interface }}"
ACTION="${1:-up}"

route() { # route <add|del> <args...>
  local op="$1"; shift
  if [ "$op" = add ]; then ip route replace "$@"; else ip route del "$@" 2>/dev/null || true; fi
}
rule() { # rule <add|del> <args...>
  local op="$1"; shift
  ip rule del "$@" 2>/dev/null || true
  if [ "$op" = add ]; then ip rule add "$@"; fi
}

if [ "$ACTION" = up ]; then OP=add; else OP=del; fi

# Overlay subnet
route "$OP" {{ wg_network }} dev "$IFACE"

# Site LAN routes are now managed by BGP via FRR (roles/frr_hub).
# Routes installed dynamically: ip route show proto bgp

# Table {{ wg_pbr_table }}: fail-closed floor. wg-exit-sync installs the
# BGP-elected exit default here with metric 20, shadowing the floor; when
# no exit site announces 0.0.0.0/0 the floor wins and home clients get
# ICMP unreachable instead of leaking out of the hub's own uplink.
route "$OP" unreachable default table {{ wg_pbr_table }} metric 4294967294

{% for c in clients if c.profile | default('cloud') == 'home' %}
# home profile: {{ c.name }} egresses through the elected exit site
rule "$OP" from {{ c.ip }}/32 table {{ wg_pbr_table }}
{% endfor %}

exit 0
