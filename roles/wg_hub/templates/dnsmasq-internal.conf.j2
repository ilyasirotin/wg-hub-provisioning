# Managed by Ansible. Authoritative for {{ wg_domain }} + upstream forwarding.
listen-address={{ hub.ip }}
bind-dynamic
no-resolv
strict-order
{% for s in dns_upstreams %}
server={{ s }}
{% endfor %}
domain-needed
bogus-priv
cache-size=2000

# Internal zone is never forwarded upstream
local=/{{ wg_domain }}/

host-record=hub.{{ wg_domain }},{{ hub.ip }}
{% for sid, s in sites.items() %}
{% for n in s.dns_names | default([sid]) %}
host-record={{ n }}.{{ wg_domain }},{{ s.ip }}
{% endfor %}
{% endfor %}
{% for c in clients %}
host-record={{ c.name | replace('_','-') }}.{{ wg_domain }},{{ c.ip }}
{% endfor %}
{% for svc in services %}
{% for n in svc.dns_names | default([svc.name]) %}
host-record={{ n }}.{{ wg_domain }},{{ svc.ip }}
{% endfor %}
{% endfor %}
