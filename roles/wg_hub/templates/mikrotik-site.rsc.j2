# Managed by Ansible. WireGuard config for {{ item.name }} ({{ item.description | default('') }}).
# Paste on THIS router (Winbox terminal / SSH). Run under Safe Mode if remote.
# The hub generated this router's keypair, so the keys below are complete and
# ready to use - no placeholders. AllowedIPs = overlay + all OTHER sites' LANs,
# so this router reaches every other house and all services.
#
# Assumes interface "wg-client" already exists (both current routers have it).
# For a BRAND-NEW router, create it first:
#   /interface wireguard add name=wg-client listen-port={{ wg_port }} mtu=1420
#   /interface list member add interface=wg-client list=VPN
#   /interface list member add interface=wg-client list=DISCOVER

# 1. This router's WireGuard private key (generated by the hub)
/interface wireguard set [find name=wg-client] private-key="{{ wg_hub_peer_data[item.name]['priv'] }}"

# 2. Point the peer at the hub (drop any old peer on this interface, re-add)
/interface wireguard peers remove [find interface=wg-client]
/interface wireguard peers add interface=wg-client \
    public-key="{{ wg_hub_server_keys['server.pub'] }}" \
    preshared-key="{{ wg_hub_peer_data[item.name]['psk'] }}" \
    endpoint-address={{ hub.public_host }} endpoint-port={{ wg_port }} \
    persistent-keepalive=25s \
    allowed-address={{ wg_network }}{% for sid, s in sites.items() if sid != item.name %},{{ s.subnets | join(',') }}{% endfor %}


# 3. Overlay address on wg-client
/ip address set [find interface=wg-client] address={{ item.ip }}/{{ wg_network.split('/')[1] }} network={{ wg_network.split('/')[0] }}

# Routers keep their own WAN for normal internet. Only the hub marks one router
# as exit_node, for home-profile clients - no 0.0.0.0/0 needed here.

# 4. Internal zone DNS: forward *.{{ wg_domain }} to hub
/ip dns static remove [find type=FWD name="{{ wg_domain }}"]
/ip dns static add type=FWD name="{{ wg_domain }}" forward-to={{ hub.ip }}
