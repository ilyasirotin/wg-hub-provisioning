# Managed by Ansible. WireGuard + BGP config for {{ item.name }} ({{ item.description | default('') }}).
# Paste on THIS router (Winbox terminal / SSH). Run under Safe Mode if remote.
# The hub generated this router's keypair — keys below are complete, no placeholders.
# Idempotent: existing WireGuard peers and BGP config are removed and re-added.
#
# Assumes interface "wg-client" already exists. For a BRAND-NEW router:
#   /interface wireguard add name=wg-client listen-port={{ wg_port }} mtu=1420
#   /interface list member add interface=wg-client list=VPN
#   /interface list member add interface=wg-client list=DISCOVER

# ── WireGuard ─────────────────────────────────────────────────────────────────

# 1. This router's WireGuard private key (generated by the hub)
/interface wireguard set [find name=wg-client] private-key="{{ wg_hub_peer_data[item.name]['priv'] }}"

# 2. Hub peer (remove any old peer on this interface, re-add)
/interface wireguard peers remove [find interface=wg-client]
/interface wireguard peers add interface=wg-client \
    public-key="{{ wg_hub_server_keys['server.pub'] }}" \
    preshared-key="{{ wg_hub_peer_data[item.name]['psk'] }}" \
    endpoint-address={{ hub.public_host }} endpoint-port={{ wg_port }} \
    persistent-keepalive=25s \
    allowed-address={{ wg_network }}{% for sid, s in sites.items() if sid != item.name %},10.{{ s.number }}.0.0/16{% endfor %}


# 3. Overlay address on wg-client
/ip address set [find interface=wg-client] address={{ item.ip }}/{{ wg_network.split('/')[1] }} network={{ wg_network.split('/')[0] }}

# 4. Internal zone DNS: forward *.{{ wg_domain }} to hub
/ip dns static remove [find type=FWD name="{{ wg_domain }}"]
/ip dns static add type=FWD name="{{ wg_domain }}" match-subdomain=yes forward-to={{ hub.ip }}

# ── BGP cleanup (idempotent) ──────────────────────────────────────────────────
# Remove by name before re-adding. Safe on first run: [find ...] returns empty set.

/routing bgp connection remove [find name=wg-hub]
/routing bgp instance remove [find name=wg-bgp-inst]
/routing id remove [find name=wg-bgp-id]
/ip firewall address-list remove [find list=BGP_Export]
/ip route remove [find comment="BGP advertisement anchor"]

# ── BGP (eBGP to hub, announces this site's LAN supernet) ────────────────────
# Hub ASN: {{ frr_hub_asn }}  |  This router ASN: {{ 65010 + item.number }}
# Hub learns LAN routes dynamically; no static routes needed on the hub side.
# Cross-site routing (e.g. site_a reaching site_b LANs) works via allowed-address
# /16 supernets above — no manual /ip route entries for other sites are needed.

# 5. Router ID tied to the overlay IP
/routing id add name=wg-bgp-id id={{ item.ip }}

# 6. BGP instance with this site's private ASN
/routing bgp instance add name=wg-bgp-inst as={{ 65010 + item.number }} router-id=wg-bgp-id

# 7. Address list: the /16 supernet this site announces to the hub
/ip firewall address-list add list=BGP_Export address=10.{{ item.number }}.0.0/16 comment="BGP Export"

# 8. BGP connection to the hub
{% if item.exit_priority is defined %}
#    Exit-capable site (exit_priority={{ item.exit_priority }}):
#    output.default-originate=if-installed announces 0.0.0.0/0 only while a
#    default route is installed (the ISP PPPoE/DHCP one) — losing WAN
#    withdraws it and the hub fails over to the next exit site, while the
#    LAN /16 stays announced via its blackhole anchor. output.network cannot
#    do this: it only picks up static routes, not the dynamic ISP default.
{% endif %}
/routing bgp connection add name=wg-hub \
    instance=wg-bgp-inst \
    local.address={{ item.ip }} \
    local.role=ebgp \
    remote.address={{ hub.ip }} \
    remote.as={{ frr_hub_asn }} \
    output.network=BGP_Export \
{% if item.exit_priority is defined %}
    output.default-originate=if-installed \
{% endif %}
    connect=yes \
    listen=yes

# 9. Blackhole anchor — BGP only announces prefixes that exist in the routing
#    table; this static blackhole makes 10.{{ item.number }}.0.0/16 present.
#    Real traffic is never blackholed: more-specific connected routes (/24 VLANs)
#    always win by longest-prefix match.
/ip route add dst-address=10.{{ item.number }}.0.0/16 blackhole comment="BGP advertisement anchor"
