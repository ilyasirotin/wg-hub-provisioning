# Managed by Ansible. Do not edit manually.
# Firewall: /etc/nftables.conf | Routes/PBR: /usr/local/sbin/wg0-routes.sh
[Interface]
Address = {{ hub.ip }}/{{ wg_network.split('/')[1] }}
ListenPort = {{ wg_port }}
PrivateKey = {{ wg_hub_server_keys['server.priv'] }}
Table = off

{% for peer in wg_hub_peers %}
# {{ peer.kind }}: {{ peer.name }}{% if peer.description is defined %} - {{ peer.description }}{% endif %}

[Peer]
PublicKey = {{ wg_hub_peer_data[peer.name]['pub'] }}
PresharedKey = {{ wg_hub_peer_data[peer.name]['psk'] }}
{% if peer.kind == 'site' %}
{# The elected exit site's 0.0.0.0/0 is RUNTIME state owned by wg-exit-sync
   (BGP-driven failover) — deliberately not rendered here. `wg syncconf`
   stripping it is expected; the daemon re-adds it within ~1s. #}
AllowedIPs = {{ peer.ip }}/32, 10.{{ peer.number }}.0.0/16
{% else %}
AllowedIPs = {{ peer.ip }}/32
{% endif %}
{% endfor %}
