#!/usr/bin/env bash
# Managed by Ansible. Pulls the wildcard cert from the hub (read-only rrsync).
set -euo pipefail
rsync -a --timeout=30 \
  -e "ssh -p {{ ssh_port }} -i /etc/wg-certs-sync/id_ed25519 -o StrictHostKeyChecking=accept-new" \
  {{ cert_sync_user }}@{{ hub.ip }}:/ /etc/wg-certs/
chmod 640 /etc/wg-certs/*.pem
{% if svc.nginx | default(false) %}
chgrp www-data /etc/wg-certs/*.pem || true
systemctl reload nginx 2>/dev/null || true
{% endif %}
