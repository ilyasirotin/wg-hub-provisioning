# Managed by Ansible. {{ svc.name }} ({{ svc.ip }})
[Interface]
Address = {{ svc.ip }}/32
PrivateKey = {{ member_keys[svc.name ~ '.priv'] }}
DNS = {{ hub.ip }}

[Peer]
PublicKey = {{ member_keys['server.pub'] }}
PresharedKey = {{ member_keys[svc.name ~ '.psk'] }}
Endpoint = {{ hub.public_host }}:{{ wg_port }}
{% set nets = [wg_network] %}
{% for sid, s in sites.items() %}{% for n in s.subnets %}{% set _ = nets.append(n) %}{% endfor %}{% endfor %}
AllowedIPs = {{ nets | join(', ') }}
PersistentKeepalive = 25
