        {
          "refId": "A",
          "expr": "100 * (1 - node_memory_MemAvailable_bytes{job=\"wg-hub\"} / node_memory_MemTotal_bytes{job=\"wg-hub\"})",
          "legendFormat": "mem"
        }
      ]
    },
    {
      "id": 9,
      "type": "gauge",
      "title": "Disk /",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "mappings": [],
          "thresholds": {
