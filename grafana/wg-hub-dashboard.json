          "legendFormat": "disk"
        }
      ]
    },
    {
      "id": 10,
      "type": "table",
      "title": "Peers",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 10,
        "w": 14,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Handshake age"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 180
                    },
                    {
                      "color": "red",
                      "value": 300
                    }
                  ]
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "range",
                    "options": {
                      "from": 1500000000,
                      "to": null,
                      "result": {
                        "text": "never",
                        "color": "#666666",
                        "index": 0
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "RX rate"
            },
            "properties": [
              {
                "id": "unit",
                "value": "Bps"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "TX rate"
            },
            "properties": [
              {
                "id": "unit",
                "value": "Bps"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "RX total"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "TX total"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Kind"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "Handshake age",
            "desc": false
          }
        ]
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "peer": "Peer",
              "kind": "Kind",
              "Value #A": "Handshake age",
              "Value #B": "RX rate",
              "Value #C": "TX rate",
              "Value #D": "RX total",
              "Value #E": "TX total"
            },
            "indexByName": {
              "peer": 0,
              "kind": 1,
              "Value #A": 2,
              "Value #B": 3,
              "Value #C": 4,
              "Value #D": 5,
              "Value #E": 6
            }
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (peer, kind) (time() - wireguard_peer_latest_handshake_seconds{job=\"wg-hub\"})",
          "format": "table",
          "instant": true,
          "legendFormat": ""
        },
        {
          "refId": "B",
          "expr": "sum by (peer, kind) (rate(wireguard_peer_receive_bytes_total{job=\"wg-hub\"}[$__rate_interval]))",
          "format": "table",
          "instant": true,
          "legendFormat": ""
        },
        {
          "refId": "C",
          "expr": "sum by (peer, kind) (rate(wireguard_peer_transmit_bytes_total{job=\"wg-hub\"}[$__rate_interval]))",
          "format": "table",
          "instant": true,
          "legendFormat": ""
        },
        {
          "refId": "D",
          "expr": "sum by (peer, kind) (wireguard_peer_receive_bytes_total{job=\"wg-hub\"})",
          "format": "table",
          "instant": true,
          "legendFormat": ""
        },
        {
          "refId": "E",
          "expr": "sum by (peer, kind) (wireguard_peer_transmit_bytes_total{job=\"wg-hub\"})",
          "format": "table",
          "instant": true,
          "legendFormat": ""
        }
      ]
    },
