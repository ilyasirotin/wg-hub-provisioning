{
  "__inputs": [
    {
      "name": "DS_ES_LOGS",
      "label": "Elasticsearch-logs",
      "description": "Central logs Elasticsearch datasource",
      "type": "datasource",
      "pluginId": "elasticsearch",
      "pluginName": "Elasticsearch"
    }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "schemaVersion": 39,
  "tags": ["logs", "elk"],
  "templating": {
    "list": [
      {
        "name": "log_source",
        "label": "Source",
        "type": "custom",
        "query": "All : *,router : router,vps : vps",
        "current": { "text": "All", "value": "*" },
        "includeAll": false,
        "multi": false
      },
      {
        "name": "search",
        "label": "Lucene query",
        "type": "textbox",
        "query": "",
        "current": { "text": "", "value": "" }
      }
    ]
  },
  "time": { "from": "now-24h", "to": "now" },
  "title": "Logs — overview (ELK)",
  "uid": "logs-overview",
  "panels": [
    {
      "id": 1,
      "title": "Log volume over time",
      "type": "timeseries",
      "datasource": { "type": "elasticsearch", "uid": "${DS_ES_LOGS}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "query": "log_source:$log_source $search",
          "metrics": [ { "id": "1", "type": "count" } ],
          "bucketAggs": [
            { "id": "3", "type": "terms", "field": "host", "settings": { "size": "20", "order": "desc", "orderBy": "_count", "min_doc_count": "0" } },
            { "id": "2", "type": "date_histogram", "field": "@timestamp", "settings": { "interval": "auto", "min_doc_count": "0" } }
          ]
        }
      ]
    },
    {
      "id": 2,
      "title": "Logs",
      "type": "logs",
      "datasource": { "type": "elasticsearch", "uid": "${DS_ES_LOGS}" },
      "gridPos": { "h": 18, "w": 24, "x": 0, "y": 8 },
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true },
      "targets": [
        {
          "refId": "A",
          "query": "log_source:$log_source $search",
          "metrics": [ { "id": "1", "type": "logs" } ],
          "bucketAggs": []
        }
      ]
    }
  ]
}
