# logs VPS ELK secrets. Copy to .env, fill in, chmod 600. .env is gitignored.
#   cp .env.example .env && chmod 600 .env
#
# Generate strong values, e.g.:
#   ELASTIC_PASSWORD / KIBANA_PASSWORD : openssl rand -base64 24
#   KIBANA_ENCRYPTION_KEY              : openssl rand -hex 32   (must be >= 32 chars)

# Superuser 'elastic' password (bootstrap). Also used by Fluent Bit and the
# Grafana datasource on the metrics VPS to write/read logs-* indices.
ELASTIC_PASSWORD=change_me_strong_elastic_password

# Password for the built-in 'kibana_system' user. NOTE: this is NOT set by the
# bootstrap env above — after Elasticsearch is up you must set it via the API
# (see README, step "Set kibana_system password"), then put the same value here.
KIBANA_PASSWORD=change_me_strong_kibana_system_password

# Kibana saved-objects / security encryption key (>= 32 chars, keep stable —
# rotating it invalidates encrypted saved objects).
KIBANA_ENCRYPTION_KEY=change_me_openssl_rand_hex_32_here
